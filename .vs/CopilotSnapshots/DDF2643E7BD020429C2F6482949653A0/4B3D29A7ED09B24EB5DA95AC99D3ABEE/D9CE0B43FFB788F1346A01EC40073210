/* Basic reset */
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; line-height: 1.4; }

/* Fixed navbar */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 64px;
  background: #ffffff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  z-index: 1000;
  display: flex;
  align-items: center;
}

.nav-inner {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.logo { font-weight: 700; font-size: 1.1rem; }

.nav-links a {
  margin-left: 1rem;
  color: #111827;
  text-decoration: none;
  font-weight: 500;
}

.nav-links a:hover { text-decoration: underline; }

/* Push content below the fixed navbar */
body { padding-top: 64px; }

main { max-width: 1100px; margin: 0 auto; padding: 1rem; }
.hero { padding: 1rem 0; }
.content-sample p { margin: 0 0 1rem 0; }

/* Small screens */
@media (max-width: 520px) {
  .nav-links a { margin-left: 0.6rem; font-size: 0.95rem; }
  .nav-inner { padding: 0 0.6rem; }
}
